        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "  pm.collectionVariables.set('token', data.token);",
                  "}",
                  "if (data.id) {",
                  "  pm.collectionVariables.set('userId', data.id);",
                  "}",
                  "if (data.email) {",
                  "  pm.collectionVariables.set('userEmail', data.email);",
                  "}",
                  "if (data.role) {",
                  "  pm.collectionVariables.set('role', data.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{api_base}}/auth/login",
              "host": [
                "{{api_base}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns token, id, name, email, and role. The test script stores token/user variables."
          },
          "response": []
        },

        {
          "name": "Create Product - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.id) { pm.collectionVariables.set('productId', data.id); }",
                  "if (data.sku) { pm.collectionVariables.set('productSku', data.sku); }",
                  "if (data.category) { pm.collectionVariables.set('category', data.category); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"MacBook Pro 14\",\n  \"description\": \"Apple M3 Pro laptop with 18GB memory and 512GB storage.\",\n  \"sku\": \"MBP-14-M3-001\",\n  \"price\": 140000.00,\n  \"quantity\": 10,\n  \"category\": \"Laptops\",\n  \"imageUrl\": \"https://example.com/macbook.jpg\",\n  \"active\": true\n}"
